# Copia a .env (demo.sh lo hace solo) y pon tu llave. Nunca subas .env al repo.

# Obligatoria: tu llave de la API de modelos de Meta (Muse Spark, Muse Voice Transcribe y SAM).
META_API_KEY=

# Opcional: voz de Jolly con Cartesia. Sin ella, Jolly usa la voz del sistema.
CARTESIA_API_KEY=

# demo.sh agrega aquí, la primera vez, FIELD_ENCRYPTION_KEY, INTERNAL_API_TOKEN y MANAGED_META_API_KEY.
