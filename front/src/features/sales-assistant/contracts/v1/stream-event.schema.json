{
  "$id": "https://saleads.ai/contracts/one-click/v1/stream-event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "token"
        },
        "text": {
          "type": "string"
        }
      },
      "required": ["type", "text"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "tool_start"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": ["type", "name"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "tool_end"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": ["type", "name", "ok"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "message_end"
        }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "mcp_unavailable"
        }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "provider_error"
        },
        "reason": {
          "type": "string",
          "enum": ["auth", "quota", "rate_limit"]
        }
      },
      "required": ["type", "reason"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "assistant_restarting"
        }
      },
      "required": ["type"],
      "additionalProperties": false
    }
  ]
}
