{
  "$id": "https://saleads.ai/contracts/one-click/v1/brain-snapshot-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "generated_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "node_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "edge_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "graph": {
      "type": "object",
      "properties": {
        "business_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "nodes": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 64
              },
              "type": {
                "type": "string",
                "maxLength": 64
              },
              "family": {
                "type": "string",
                "enum": [
                  "identity",
                  "offer",
                  "market",
                  "competition",
                  "channels",
                  "strategy",
                  "operations",
                  "learning",
                  "meta",
                  "learned",
                  "other"
                ]
              },
              "label": {
                "type": "string",
                "maxLength": 200
              },
              "summary": {
                "type": "string",
                "maxLength": 500
              },
              "state": {
                "type": "string",
                "enum": ["observed", "proposed", "validated", "superseded"]
              },
              "provenance": {
                "type": "string",
                "maxLength": 40
              },
              "mentions": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "created_at": {
                "type": ["string", "null"]
              }
            },
            "required": [
              "id",
              "type",
              "family",
              "label",
              "summary",
              "state",
              "provenance",
              "mentions",
              "created_at"
            ],
            "additionalProperties": false
          }
        },
        "edges": {
          "maxItems": 2000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "maxLength": 64
              },
              "fact": {
                "type": "string",
                "maxLength": 300
              },
              "provenance": {
                "type": "string",
                "maxLength": 40
              },
              "valid_at": {
                "type": ["string", "null"]
              },
              "invalid_at": {
                "type": ["string", "null"]
              }
            },
            "required": [
              "source",
              "target",
              "type",
              "fact",
              "provenance",
              "valid_at",
              "invalid_at"
            ],
            "additionalProperties": false
          }
        },
        "stats": {
          "type": "object",
          "properties": {
            "nodes": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "edges": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": ["nodes", "edges"],
          "additionalProperties": false
        }
      },
      "required": ["business_id", "nodes", "edges", "stats"],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "created_at",
    "generated_at",
    "node_count",
    "edge_count",
    "graph"
  ],
  "additionalProperties": false
}
