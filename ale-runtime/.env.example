# Example only. Replace placeholders with your own deployment configuration.
# Node 22+: node --env-file=.env dist/src/main.js
# No credential in this file is usable. Do not commit a populated .env.

PORT=8060
MANAGED_META_ENABLED=false
# Explicitly opens this managed deployment to authenticated accounts allowed by its backend flag.
MANAGED_META_ALL_USERS=false
# Required in pilot mode; ignored for admission when MANAGED_META_ALL_USERS=true.
MANAGED_META_USER_ID=
# HTTPS base ending in /v1; required in all-account mode. The plugin appends /responses.
MANAGED_META_RELAY_BASE_URL=
# Private inference credential; never an OAuth, business API, or approval executor credential.
MANAGED_META_API_KEY=
# Stock (inventario-vivo-v1). Off by default: no routes, no queries, no background work.
STOCK_ENABLED=false
# Comma-separated Keycloak subjects allowed to use Stock.
STOCK_USER_IDS=
# Comma-separated business_id:user_id:currency. Every user must be in STOCK_USER_IDS or startup fails.
STOCK_BUSINESS_SEEDS=
STOCK_WEB_BASE_URL=
STOCK_ADDON_DIR=distribution/stock-addon/1.0.8
# Brain image with the stock role, pinned by digest. Required when STOCK_USER_IDS is not empty.
STOCK_BRAIN_IMAGE=
STOCK_BUCKET=
STOCK_RELAY_URL=
STOCK_RELAY_KEY=
STOCK_BENCH_ENABLED=false
STOCK_MAX_AUTONOMY_LEVEL=2
STOCK_TOOL_WAIT_MS=240000
STOCK_SYNC_INTERVAL_MS=300000
STOCK_EXTRACT_MODEL=
# Supplier channel adapter. Empty: supplier send and wait answer 503. `banco` is simulated and needs STOCK_BENCH_ENABLED=true.
# `telegram` uses a supplier bot owned by this service (never the assistant's bot) and needs the token below.
STOCK_SUPPLIER_CHANNEL=
# Fixed destination, read only by the adapter. It never reaches the model. With `telegram`: the numeric user id of the supplier.
STOCK_SUPPLIER_DESTINATION=
# Secret. Only with STOCK_SUPPLIER_CHANNEL=telegram; from the service's secret store, never from the VM.
STOCK_SUPPLIER_TELEGRAM_TOKEN=
STOCK_SUPPLIER_SENDER_NAME=
DATABASE_URL=postgresql://assistant:REPLACE_PASSWORD@localhost:5432/assistant
DATABASE_POOL_MAX=5

# Web identity and the assistant's separate OAuth client.
KEYCLOAK_ISSUER=https://identity.example.invalid/realms/example
KEYCLOAK_JWKS_URL=https://identity.example.invalid/realms/example/protocol/openid-connect/certs
KEYCLOAK_AUTHORIZE_URL=https://identity.example.invalid/realms/example/protocol/openid-connect/auth
KEYCLOAK_TOKEN_URL=https://identity.example.invalid/realms/example/protocol/openid-connect/token
KEYCLOAK_REVOKE_URL=https://identity.example.invalid/realms/example/protocol/openid-connect/revoke
OIDC_AUDIENCE=
OIDC_ALLOWED_CLIENTS=example-web
ASSISTANT_OAUTH_CLIENT_ID=example-assistant
ASSISTANT_OAUTH_REDIRECT_URI=https://app.example.invalid/api/sales-assistant/oauth/callback
ASSISTANT_OAUTH_SCOPE="openid offline_access saleads-mcp saleads:read saleads:strategy saleads:campaigns saleads:launch saleads:events"

# Required secrets: supply from your secret manager.
# FIELD_ENCRYPTION_KEY must decode to exactly 32 random bytes (base64).
FIELD_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
POSTHOG_API_KEY=REPLACE_WITH_FEATURE_FLAG_PROJECT_KEY
POSTHOG_HOST=https://analytics.example.invalid
ASSISTANT_FLAG_KEY=sales-assistant-enabled
# Independent values, each 32-512 non-whitespace ASCII characters.
INTERNAL_API_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_API_TOKEN
SALEADS_SERVICES_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_SERVICES_TOKEN
BRAIN_HUB_ADMIN_USER_IDS=

# Assistant-facing interfaces.
MCP_URL=https://app.example.invalid/mcp
AGENT_API_URL=https://app.example.invalid
WEB_APP_URL=https://app.example.invalid

# Current control-service callbacks; configure endpoints for your environment.
STRATEGY_SERVICE_URL=https://strategy.example.invalid
CAMPAIGN_SERVICE_URL=https://campaign.example.invalid
INTEGRATION_SERVICE_URL=https://integration.example.invalid
SUBSCRIPTION_SERVICE_URL=https://subscription.example.invalid
BI_SERVICE_URL=https://business-intelligence.example.invalid

# Your Compute Engine template, memory bucket, and signing identity.
# Cloud credentials come from the configured workload identity, not this file.
GCP_PROJECT=example-project
ASSISTANT_RUNTIME_NAMESPACE=
GCP_ZONE=us-central1-a
ASSISTANT_INSTANCE_TEMPLATE=projects/example-project/global/instanceTemplates/example-assistant
ASSISTANT_MEMORIES_BUCKET=example-assistant-memories
ASSISTANT_SIGNER_EMAIL=example-signer@example-project.iam.gserviceaccount.com
HERMES_API_PORT=8642

# Explicitly select a matching included bundle.
ASSISTANT_BUNDLE_DIR=distribution/saleads-sales-agent/1.5.10
ASSISTANT_BUNDLE_VERSION=saleads-sales-agent@1.5.10
# Empty disables brain integration. If used, supply a compatible digest-pinned image.
BRAIN_IMAGE=

# Keep optional integrations off until their services and permissions are validated.
AGENT_ACTIVATION_APPROVALS_ENABLED=false
SPECIALIST_EXPLICIT_READS_ENABLED=false
RESEARCHER_NATIVE_SEARCH_ENABLED=false
AGENT_TRACE_WRITER_ENABLED=false
KNOWLEDGE_SYNC_ENABLED=false
BRAIN_SNAPSHOT_POLL_ENABLED=false
ORQA_JOB_UPDATES_ENABLED=false
ORQA_SYNC_SWEEP_ENABLED=false
ORQA_SYNC_SWEEP_INCLUDE_LAB=false

# See src/config.ts for bounded timeouts, renewal, polling, and archive settings.
