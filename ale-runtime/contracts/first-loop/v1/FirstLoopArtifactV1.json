{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "stage": {
      "type": "string",
      "enum": [
        "research",
        "strategy",
        "structure",
        "analysis",
        "optimization",
        "summary"
      ]
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "content_type": {
      "type": "string",
      "enum": [
        "text/markdown",
        "text/plain",
        "application/json"
      ]
    },
    "content": {
      "type": "string",
      "maxLength": 131072
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 262144
    },
    "response_locale": {
      "type": "string",
      "enum": [
        "es",
        "en"
      ]
    },
    "sources": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "title",
          "url"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "task_id",
    "stage",
    "revision",
    "title",
    "content_type",
    "content",
    "sha256",
    "bytes",
    "response_locale",
    "sources"
  ],
  "additionalProperties": false
}
