{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "profile": {
      "type": "string",
      "enum": [
        "investigador",
        "estratega",
        "estructurador",
        "analista",
        "optimizador"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "research",
        "strategy",
        "structure",
        "analysis",
        "optimization",
        "summary"
      ]
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "awaiting_review",
        "completed",
        "blocked",
        "failed",
        "cancelled",
        "unknown"
      ]
    },
    "native_status": {
      "type": "string",
      "maxLength": 50
    },
    "parents": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
      }
    },
    "run_refs": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
      }
    },
    "execution_verified": {
      "type": "boolean"
    },
    "updated_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "profile",
    "stage",
    "revision",
    "title",
    "status",
    "native_status",
    "parents",
    "run_refs",
    "execution_verified",
    "updated_at"
  ],
  "additionalProperties": false
}
