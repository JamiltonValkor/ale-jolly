{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "first-loop/1"
    },
    "work_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "business_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "flow_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "brief_revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "response_locale": {
      "type": "string",
      "enum": [
        "es",
        "en"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting_for_tasks",
        "running",
        "awaiting_feedback",
        "reviewing",
        "completed",
        "blocked",
        "unknown"
      ]
    },
    "projection": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "missing",
            "fresh",
            "stale",
            "invalid",
            "unavailable"
          ]
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 150
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "observed_at",
        "cursor"
      ],
      "additionalProperties": false
    },
    "tasks": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
          },
          "profile": {
            "type": "string",
            "enum": [
              "investigador",
              "estratega",
              "estructurador",
              "analista",
              "optimizador"
            ]
          },
          "stage": {
            "type": "string",
            "enum": [
              "research",
              "strategy",
              "structure",
              "analysis",
              "optimization",
              "summary"
            ]
          },
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "awaiting_review",
              "completed",
              "blocked",
              "failed",
              "cancelled",
              "unknown"
            ]
          },
          "native_status": {
            "type": "string",
            "maxLength": 50
          },
          "parents": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
            }
          },
          "run_refs": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
            }
          },
          "execution_verified": {
            "type": "boolean"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "profile",
          "stage",
          "revision",
          "title",
          "status",
          "native_status",
          "parents",
          "run_refs",
          "execution_verified",
          "updated_at"
        ],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "task_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
          },
          "stage": {
            "type": "string",
            "enum": [
              "research",
              "strategy",
              "structure",
              "analysis",
              "optimization",
              "summary"
            ]
          },
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "content_type": {
            "type": "string",
            "enum": [
              "text/markdown",
              "text/plain",
              "application/json"
            ]
          },
          "content": {
            "type": "string",
            "maxLength": 131072
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 262144
          },
          "response_locale": {
            "type": "string",
            "enum": [
              "es",
              "en"
            ]
          },
          "sources": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "maxLength": 300
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "title",
                "url"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "task_id",
          "stage",
          "revision",
          "title",
          "content_type",
          "content",
          "sha256",
          "bytes",
          "response_locale",
          "sources"
        ],
        "additionalProperties": false
      }
    },
    "feedback_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "delivery": {
      "type": "string",
      "enum": [
        "pending",
        "available",
        "unavailable"
      ]
    }
  },
  "required": [
    "schema_version",
    "work_id",
    "business_id",
    "flow_id",
    "brief_revision",
    "revision",
    "response_locale",
    "status",
    "projection",
    "tasks",
    "artifacts",
    "feedback_count",
    "delivery"
  ],
  "additionalProperties": false
}
