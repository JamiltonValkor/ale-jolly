{
  "$id": "https://saleads.ai/contracts/continuous-loop/v1/context-pack.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "context-pack/1"
    },
    "pack_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
    },
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "business_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "actor_role": {
      "type": "string",
      "enum": [
        "ale",
        "investigador",
        "estratega",
        "estructurador",
        "analista",
        "optimizador",
        "disenador_landings",
        "curador"
      ]
    },
    "goal": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "schema_version": {
              "type": "string",
              "const": "goal-state/1"
            },
            "goal_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
            },
            "owner_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "business_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "origin": {
              "type": "string",
              "enum": [
                "assistant_proposed",
                "owner_confirmed"
              ]
            },
            "mandate": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "source_event_ids": {
              "minItems": 1,
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
              }
            },
            "native_task_ids": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
              }
            },
            "state": {
              "type": "string",
              "enum": [
                "intake",
                "active",
                "waiting",
                "blocked",
                "completed",
                "cancelled"
              ]
            },
            "blockers": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "next_condition": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ]
            },
            "next_review_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "result_summary": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 4000
                },
                {
                  "type": "null"
                }
              ]
            },
            "revision": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "updated_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          },
          "required": [
            "schema_version",
            "goal_id",
            "owner_id",
            "business_id",
            "origin",
            "mandate",
            "source_event_ids",
            "native_task_ids",
            "state",
            "blockers",
            "next_condition",
            "next_review_at",
            "result_summary",
            "revision",
            "updated_at"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "knowledge": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "knowledge-candidate/1"
          },
          "candidate_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
          },
          "owner_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "business_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "entity_type": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z]{1,63}$"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "attributes": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 4000
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "source_event_ids": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
            }
          },
          "scope": {
            "type": "string",
            "enum": [
              "business",
              "specialist",
              "team"
            ]
          },
          "specialist_role": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "investigador",
                  "estratega",
                  "estructurador",
                  "analista",
                  "optimizador",
                  "disenador_landings"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "extractor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
          },
          "epistemic": {
            "type": "string",
            "enum": [
              "declared",
              "observed",
              "inferred"
            ]
          },
          "validation_state": {
            "type": "string",
            "enum": [
              "proposed",
              "confirmed",
              "pending_conflict",
              "rejected",
              "superseded"
            ]
          },
          "valid_from": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "valid_until": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "supersedes_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "contradicts_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "schema_version",
          "candidate_id",
          "owner_id",
          "business_id",
          "entity_type",
          "content",
          "attributes",
          "source_event_ids",
          "scope",
          "specialist_role",
          "extractor_id",
          "epistemic",
          "validation_state",
          "valid_from",
          "valid_until",
          "supersedes_id",
          "contradicts_id"
        ],
        "additionalProperties": false
      }
    },
    "experiences": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "specialist-experience/1"
          },
          "experience_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
          },
          "owner_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "business_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "specialist_role": {
            "type": "string",
            "enum": [
              "investigador",
              "estratega",
              "estructurador",
              "analista",
              "optimizador",
              "disenador_landings"
            ]
          },
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
          },
          "run_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "observed_result": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "correction": {
            "type": "string",
            "maxLength": 2000
          },
          "lesson": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "applicability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "source_event_ids": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "proposed",
              "supported",
              "validated"
            ]
          },
          "valid_from": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "valid_until": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "shared_summary": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "schema_version",
          "experience_id",
          "owner_id",
          "business_id",
          "specialist_role",
          "task_id",
          "run_id",
          "method",
          "observed_result",
          "correction",
          "lesson",
          "applicability",
          "source_event_ids",
          "confidence",
          "valid_from",
          "valid_until",
          "shared_summary"
        ],
        "additionalProperties": false
      }
    },
    "refs": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
      }
    },
    "versions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
      },
      "additionalProperties": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "pending": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "text": {
      "type": "string",
      "maxLength": 8000
    },
    "truncated": {
      "type": "boolean"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schema_version",
    "pack_id",
    "owner_id",
    "business_id",
    "actor_role",
    "goal",
    "knowledge",
    "experiences",
    "refs",
    "versions",
    "pending",
    "text",
    "truncated",
    "generated_at"
  ],
  "additionalProperties": false
}
