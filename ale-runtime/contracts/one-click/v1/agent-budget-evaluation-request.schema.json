{
  "$id": "https://saleads.ai/contracts/one-click/v1/agent-budget-evaluation-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "spent_to_date_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "projected_active_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "requested_delta_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "campaign_spent_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "business_id",
    "currency",
    "spent_to_date_minor",
    "projected_active_minor",
    "requested_delta_minor"
  ],
  "additionalProperties": false
}
