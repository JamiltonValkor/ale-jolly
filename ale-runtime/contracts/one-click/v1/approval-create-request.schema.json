{
  "$id": "https://saleads.ai/contracts/one-click/v1/approval-create-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "install_skill",
        "uninstall_skill",
        "install_mcp",
        "launch_plan",
        "pause_campaign",
        "change_budget",
        "resume_campaign",
        "activate_agent_publication"
      ]
    },
    "item_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "params": {
      "type": "object",
      "properties": {
        "monthly_budget": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "required": [
            "amount",
            "currency"
          ],
          "additionalProperties": false
        },
        "campaign_ids": {
          "minItems": 1,
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "projection": {
          "type": "object",
          "properties": {
            "spent_to_date_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "projected_active_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "requested_delta_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "required": [
            "spent_to_date_minor",
            "projected_active_minor",
            "requested_delta_minor",
            "currency"
          ],
          "additionalProperties": false
        },
        "agent_action_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "business_id",
    "kind",
    "item_id"
  ],
  "additionalProperties": false
}
