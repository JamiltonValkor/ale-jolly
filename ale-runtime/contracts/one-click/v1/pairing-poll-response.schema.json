{
  "$id": "https://saleads.ai/contracts/one-click/v1/pairing-poll-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "pending"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "paired"
        },
        "device_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "device_token": {
          "type": "string",
          "minLength": 40,
          "maxLength": 200
        }
      },
      "required": [
        "status",
        "device_id",
        "device_token"
      ],
      "additionalProperties": false
    }
  ]
}
