{
  "$id": "https://saleads.ai/contracts/one-click/v1/assistant-state.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "none",
        "activating",
        "ready",
        "stopped",
        "failed",
        "deleting"
      ]
    },
    "step": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "preparing_access",
            "preparing_environment",
            "installing_agent",
            "configure_ai"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "slow": {
      "type": "boolean"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "ai": {
      "type": "object",
      "properties": {
        "configured": {
          "type": "boolean"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "configured",
        "provider",
        "model"
      ],
      "additionalProperties": false
    },
    "ready_since": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "timezone": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "status",
    "step",
    "slow",
    "session_id",
    "ai",
    "ready_since",
    "timezone"
  ],
  "additionalProperties": false
}
