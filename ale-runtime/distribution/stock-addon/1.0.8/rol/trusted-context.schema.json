{
  "$id": "https://saleads.ai/contracts/continuous-loop/v1/trusted-context.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "trusted-context/1"
    },
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "business_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
    },
    "actor_role": {
      "type": "string",
      "enum": [
        "ale",
        "investigador",
        "estratega",
        "estructurador",
        "analista",
        "optimizador",
        "disenador_landings",
        "stock",
        "curador"
      ]
    },
    "native_task_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "native_run_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "response_locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "locale_revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "capabilities": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
      }
    },
    "mandate_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "pending_context": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "owner_id",
    "business_id",
    "session_id",
    "actor_role",
    "native_task_id",
    "native_run_id",
    "response_locale",
    "locale_revision",
    "capabilities",
    "mandate_id",
    "pending_context"
  ],
  "additionalProperties": false
}
