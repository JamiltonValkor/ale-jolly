{
  "$id": "https://saleads.ai/contracts/continuous-loop/v1/specialist-experience.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "specialist-experience/1"
    },
    "experience_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
    },
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "business_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "specialist_role": {
      "type": "string",
      "enum": [
        "investigador",
        "estratega",
        "estructurador",
        "analista",
        "optimizador",
        "disenador_landings",
        "stock"
      ]
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "observed_result": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "correction": {
      "type": "string",
      "maxLength": 2000
    },
    "lesson": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "applicability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "source_event_ids": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]*$"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "proposed",
        "supported",
        "validated"
      ]
    },
    "valid_from": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "valid_until": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "shared_summary": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "experience_id",
    "owner_id",
    "business_id",
    "specialist_role",
    "task_id",
    "run_id",
    "method",
    "observed_result",
    "correction",
    "lesson",
    "applicability",
    "source_event_ids",
    "confidence",
    "valid_from",
    "valid_until",
    "shared_summary"
  ],
  "additionalProperties": false
}
