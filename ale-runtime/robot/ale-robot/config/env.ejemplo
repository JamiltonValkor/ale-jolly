# Copia este archivo a ~/ale/voz-hermes/.env en el robot (llevar_a_pi.sh lo arma por ti).
# Nunca lo subas a un repo: lleva las keys del robot.

# Oído (Muse Voice Transcribe) y voz (Cartesia)
META_API_KEY=
CARTESIA_API_KEY=

# Dónde vive ale-runtime. Debe exponer /devices/*; en desarrollo puede ser http://localhost:8060.
ALE_RUNTIME_URL=https://tu-ale-runtime.example.com

# Nombre con el que el robot aparece en SaleADS al vincularlo (opcional)
ALE_ROBOT_NAME=Jolly

# Avisos de Jolly por iniciativa propia (inventario). 0 o ausente: igual que antes. 1 enciende también ALE_EVENTOS.
# ALE_AVISOS=1

# Lo llena el emparejamiento (no lo escribas a mano):
# ALE_DEVICE_TOKEN=
# ALE_DEVICE_ID=
