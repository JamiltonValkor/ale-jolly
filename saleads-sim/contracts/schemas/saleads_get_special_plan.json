              },
              "currency": {
                "type": "string",
                "description": "Moneda ISO-4217.",
                "pattern": "^[A-Z]{3}$"
              }
            },
            "required": [
              "amount",
              "currency"
            ],
            "additionalProperties": false,
            "description": "Inversión total del lanzamiento con las fechas guardadas."
          },
          "editable": {
            "type": "boolean",
            "description": "true si aún se puede cambiar con saleads_update_special_plan."
          },
          "locked_reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Código del congelamiento (p. ej. SEAS_COMMUNICATION_SETTINGS_FROZEN, TEMPORAL_EVENTS_FROZEN)."
          }
        },
        "required": [
