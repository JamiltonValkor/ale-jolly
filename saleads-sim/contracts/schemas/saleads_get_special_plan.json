{
  "name": "saleads_get_special_plan",
  "title": "Ver plan especial",
  "description": "Devuelve la configuración del plan especial: fechas y duración, ciudades, presupuesto, oferta real con el descuento que calcula SaleADS, comunicación, audiencias, fases con sus campañas y pendientes con su link. Indica qué se puede cambiar todavía. No incluye textos ni piezas.",
  "requiredScope": "saleads:read",
  "annotations": {
    "title": "Ver plan especial",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "async": false,
  "downstream": [
    "GET /api/strategy/seasonal-plans/:planId",
    "GET /api/strategy/seasonal-plans/:planId/offer-terms",
    "GET /api/strategy/seasonal-plans/:planId/copy-authoring (solo con TEMPORAL_COPY_EXTERNAL_AUTHORING_ENABLED; 404 = todas saleads_ai)",
    "(interno MCP) handoffs open-special-plan y de pendientes"
  ],
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "special_plan_id": {
        "type": "string",
        "format": "uuid",
        "description": "ID del plan especial (de saleads_list_special_plans o saleads_create_special_plan). No es un strategy_plan_id: no lo pases a saleads_get_plan, saleads_update_plan ni a otras tools del plan estratégico normal."
      }
    },
    "required": [
      "special_plan_id"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "special_plan_id": {
        "type": "string",
        "format": "uuid",
        "description": "ID del plan especial (de saleads_list_special_plans o saleads_create_special_plan). No es un strategy_plan_id: no lo pases a saleads_get_plan, saleads_update_plan ni a otras tools del plan estratégico normal."
      },
      "business_id": {
        "type": "string",
        "format": "uuid"
      },
      "name": {
        "type": "object",
        "properties": {
          "es": {
            "type": "string",
            "description": "Texto en español."
          },
          "en": {
            "type": "string",
            "description": "Texto en inglés."
          }
        },
        "required": [
          "es"
        ],
        "additionalProperties": false,
        "description": "Texto localizado del catálogo."
      },
      "catalog_version_id": {
        "type": "string",
        "format": "uuid"
      },
      "revision": {
        "type": "integer",
        "description": "Revisión del plan en Strategy (informativa; el MCP gestiona If-Match y expected_revision).",
        "minimum": 0
      },
      "created_at": {
        "type": "string",
        "description": "Creación (ISO 8601 UTC).",
        "format": "date-time"
      },
      "currency": {
        "type": "string",
        "description": "Moneda del plan."
      },
      "timezone": {
        "type": "string",
        "description": "Zona horaria del plan."
      },
      "offering": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Tipo.",
            "enum": [
              "product",
              "service",
              "business"
            ]
          },
          "id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "ID de la oferta."
          }
        },
        "required": [
          "type",
          "id"
        ],
        "additionalProperties": false
      },
      "settings": {
