{
  "name": "saleads_agent_report_box_sales",
  "title": "Reportar ventas por caja",
  "description": "Guarda una venta que el dueño atribuye a una caja o anuncio (o anula una anterior con voids_attribution_id).",
  "requiredScope": "saleads:strategy",
  "annotations": {
    "title": "Reportar ventas por caja",
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "async": false,
  "downstream": [
    "POST /campaigns/internal/agent-metrics/v1/box-sale-attributions (AAB-011)"
  ],
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "business_id": {
        "type": "string",
        "format": "uuid",
        "description": "Negocio del dueño."
      },
      "client_request_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{8,128}$",
        "description": "Id del pedido que genera el CLI; repetirlo devuelve el mismo resultado."
      },
      "campaign_id": {
        "type": "string",
        "format": "uuid"
      },
      "ad_set_id": {
        "type": "string",
        "format": "uuid"
      },
      "ad_id": {
        "type": "string",
        "format": "uuid"
      },
      "amount": {
        "type": "number",
        "minimum": 0
      },
      "currency": {
        "type": "string",
        "pattern": "^[A-Z]{3}$"
      },
      "occurred_at": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "note": {
        "type": "string",
        "maxLength": 500
      },
      "voids_attribution_id": {
        "type": "string",
        "format": "uuid"
      }
    },
    "required": [
      "business_id",
      "client_request_id",
      "campaign_id",
      "amount",
      "currency",
      "occurred_at"
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object"
  }
}
