{
  "name": "saleads_stock_robot_say",
  "title": "Hablar por el robot",
  "description": "Pide al robot decir algo al dueño. Un aviso de Stock va solo con su alerta_id de avisos_pendientes: el texto lo pone el servidor y responde ya_dicho o no_vigente si no corresponde. Sin alerta_id, texto corto de turno. Respeta topes y horarios del servidor.",
  "requiredScope": "saleads:strategy",
  "annotations": {
    "title": "Hablar por el robot",
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "async": false,
  "downstream": [
    "POST /internal/stock/businesses/:businessId/robot/say"
  ],
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "business_id": {
        "type": "string",
        "format": "uuid",
        "description": "Negocio del dueño."
      },
      "texto": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "pregunta": {
        "type": "boolean"
      },
      "proposal_id": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          {
            "type": "null"
          }
        ]
      },
      "producto_id": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          {
            "type": "null"
          }
        ]
      },
      "prioridad": {
        "type": "string",
        "enum": [
          "normal",
          "alta"
        ]
      },
      "dedupe_key": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "alerta_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "required": [
      "business_id"
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "en_cola",
          "dicho",
          "agrupado",
          "tope_diario",
          "fuera_de_horario",
          "robot_offline",
          "ya_dicho",
          "no_vigente"
        ]
      },
      "evento_original": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "estado": {
            "type": "string",
            "enum": [
              "en_cola",
              "dicho",
              "agrupado",
              "tope_diario",
              "fuera_de_horario",
              "robot_offline"
            ]
          },
          "creado_en": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "estado",
          "creado_en"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "status"
    ],
    "additionalProperties": false
  }
}
