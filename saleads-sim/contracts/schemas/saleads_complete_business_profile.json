{
  "name": "saleads_complete_business_profile",
  "title": "Completar perfil del negocio",
  "description": "Completa automáticamente identidad, voz, audiencia y marketing del negocio. Requiere Meta conectado con página o Instagram; si no, devuelve action_url para conectarlo.",
  "requiredScope": "saleads:strategy",
  "annotations": {
    "title": "Completar perfil del negocio",
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "async": true,
  "downstream": [
    "POST /api/business-intelligence/prefill/:id/start",
    "GET /api/business-intelligence/prefill/:id/status-detail?v=2"
  ],
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "business_id": {
        "type": "string",
        "format": "uuid",
        "description": "Negocio sobre el que se actúa. El MCP verifica que pertenezca al usuario autenticado."
      },
      "language": {
        "type": "string",
        "description": "Idioma de la estrategia y los creativos.",
        "enum": [
          "es",
          "es-CO",
          "es-MX",
          "en"
        ]
      },
      "client_request_id": {
        "type": "string",
        "description": "Opcional. Identificador estable de este intento para que un reintento no duplique trabajo.",
        "minLength": 8,
        "maxLength": 100
      }
    },
    "required": [
      "business_id"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "completed_sections": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Sección completada."
            }
          },
          "failed_sections": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Sección fallida."
            }
          }
        },
        "required": [
          "completed_sections"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "description": "ID de la operación. Consultar con saleads_get_operation."
          },
          "status": {
            "type": "string",
            "description": "Estado.",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "poll_after_s": {
            "type": "integer",
            "description": "Segundos sugeridos antes de volver a consultar.",
            "minimum": 1
          },
          "result": {
            "type": "object",
            "description": "Resultado final cuando status = succeeded (forma de la tool original)."
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Código MCP-E-*."
              },
              "message": {
                "type": "string",
                "description": "Mensaje."
              },
              "next_action": {
                "type": "string",
                "description": "Qué hacer."
              },
              "retryable": {
                "type": "boolean",
                "description": "Reintentable."
              },
              "details": {
                "type": "object"
              },
              "action_url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "operation_id",
          "status"
        ],
        "additionalProperties": false,
        "description": "Envoltorio de operación asíncrona. Si el cliente soporta la extensión Tasks se usa la task nativa."
      }
    ]
  }
}
