{
  "name": "saleads_agent_prepare_landing_destination",
  "title": "Prepare a published landing destination",
  "description": "Bind the owner-published Hermes landing version to its canonical agent bet without creating advertising objects or spending. URL, digest and publication evidence are resolved by the server. Reuse the same client_request_id; read the destination to reconcile an uncertain acknowledgement.",
  "requiredScope": "saleads:strategy",
  "annotations": {
    "title": "Prepare a published landing destination",
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "async": true,
  "downstream": [
    "GET /api/strategy/internal/agent-authored/bets",
    "GET /api/landing/landings/:id",
    "GET /api/landing/agent/v1/landings/:id/versions/:n",
    "GET /api/strategy/internal/agent_authored/bets/:betId/landing_destination",
    "POST /api/strategy/internal/agent_authored/bets/:betId/landing_destination"
  ],
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "business_id": {
        "type": "string",
        "format": "uuid"
      },
      "bet_id": {
        "type": "string",
        "format": "uuid"
      },
      "locale": {
        "type": "string",
        "enum": [
          "es",
          "en"
        ]
      },
      "landing_id": {
        "type": "string",
        "format": "uuid"
      },
      "published_n": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "expected_revision": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "client_request_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{8,128}$"
      }
    },
    "required": [
      "business_id",
      "bet_id",
      "landing_id",
      "published_n",
      "expected_revision",
      "client_request_id"
    ]
  },
