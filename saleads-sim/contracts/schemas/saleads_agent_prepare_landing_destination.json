            "format": "uuid"
          },
          "business_id": {
            "type": "string",
            "format": "uuid"
          },
          "bet_id": {
            "type": "string",
            "format": "uuid"
          },
          "campaign_intent_id": {
            "type": "string",
            "format": "uuid"
          },
          "communication_strategy_id": {
            "type": "string",
            "format": "uuid"
          },
          "communication_strategy_version_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "client_request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{8,128}$"
          },
